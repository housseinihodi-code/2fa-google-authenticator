      "item": [
        {
          "name": "Setup → secret + QR code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/2fa/setup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountName\": \"postman@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Génère un secret TOTP et le QR code à scanner. Le secret est stocké dans la variable `totpSecret` pour les requêtes suivantes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test('secret présent', () => pm.expect(j.secret).to.be.a('string').and.to.have.length.above(0));",
                  "pm.test('QR code (data URL)', () => pm.expect(j.qrCodeDataUrl).to.include('data:image'));",
                  "pm.collectionVariables.set('totpSecret', j.secret);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Résultat observé - 200",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{baseUrl}}/api/2fa/setup",
                "body": { "mode": "raw", "raw": "{\n  \"accountName\": \"postman@example.com\"\n}" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"success\": true,\n  \"secret\": \"LMWGKNKYJQRUCSJGEQYGKNCNF5FFORKH\",\n  \"qrCodeDataUrl\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\"\n}"
            }
          ]
