# Copiez ce fichier en .env et renseignez vos propres valeurs.
# .env ne doit JAMAIS être commité.

PORT=4000

# Base de données MySQL dédiée (ou partagée avec votre app hôte)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=two_factor_auth

# Doit être IDENTIQUE au secret JWT de l'application hôte : le module
# fait confiance aux tokens émis par l'app appelante pour identifier l'utilisateur.
JWT_SECRET=

# Clé AES-256 (32 octets) utilisée pour chiffrer les secrets TOTP en base.
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=

# Nom affiché dans Google Authenticator à côté du compte (ex: nom de votre app)
TOTP_ISSUER=MyApp

# Fenêtre de tolérance TOTP (nombre de pas de 30s avant/après acceptés)
TOTP_WINDOW=1

# Nombre de codes de récupération générés à l'activation
RECOVERY_CODES_COUNT=10
